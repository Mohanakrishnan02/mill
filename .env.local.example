# ── Payment (pick what you need — Free Checkout works with NO keys) ──

# Option A — Free Checkout (default): Place Order without any gateway
# No env vars needed.

# Option B — Free UPI (GPay/PhonePe) — your mill UPI ID only
# Example: millname@oksbi  or  7339604011@paytm
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Jayalakshmi Vilas Rice Mill

# Option C — Razorpay (free test account → https://dashboard.razorpay.com/signup)
# Use Test keys (rzp_test_…) for free testing; Live keys for real payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Ekart Logistics — register at https://www.ekartlogistics.in/shipping-partner
EKART_MERCHANT_CODE=
EKART_AUTH_TOKEN=
EKART_API_BASE_URL=https://api.ekartlogistics.com

# Google Maps — enable Places autocomplete + pincode auto-fill on checkout
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── WhatsApp auto-send (pick ONE provider, add to Vercel env vars) ──

# Option A — Green API (recommended for quick setup)
# 1. Sign up at https://green-api.com
# 2. Create instance, scan QR with mill WhatsApp (7339604011)
# 3. Copy Instance ID + API Token below
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Option B — Meta WhatsApp Cloud API (official, for any customer number)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: approved template name for new customers (e.g. order_confirmation)
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Option C — CallMeBot (mill team only, +91 9941876024 must register once)
# Save +34 644 03 87 31 as CallMeBot, WhatsApp "I allow callmebot to send me messages"
CALLMEBOT_MILL_API_KEY=

NEXT_PUBLIC_SITE_NAME=Jayalakshmi Vilas Rice Mill

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here

# Ekart Logistics — register at https://www.ekartlogistics.in/shipping-partner
# Request API credentials (Merchant Code + Auth token) from Ekart support after approval
EKART_MERCHANT_CODE=
EKART_AUTH_TOKEN=
EKART_API_BASE_URL=https://api.ekartlogistics.com

# Google Maps — enable Places autocomplete + pincode auto-fill on checkout
# https://console.cloud.google.com/google/maps-apis/ — enable Places API & Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API (Meta Business) — preferred for auto-send with images
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# CallMeBot — free auto-send fallback (text only, no manual Send tap)
# Mill team (+91 9941876024): save +34 644 44 71 67 as "CallMeBot", then WhatsApp
# "I allow callmebot to send me messages" to that number → copy the API key here.
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_MILL_API_KEY=

# Optional: customer order confirmation auto-send (customer registers their own number)
CALLMEBOT_CUSTOMER_API_KEY=

# Jayalakshmi Vilas Rice Mill — Melur, Madurai
NEXT_PUBLIC_SITE_NAME=Jayalakshmi Vilas Rice Mill
